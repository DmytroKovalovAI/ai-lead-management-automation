    {
      "parameters": {
        "promptType": "define",
        "text": "={{ $json.note }}",
        "hasOutputParser": true,
        "messages": {
          "messageValues": [
            {
              "message": "Classify leads into one of three statuses: `cold`, `warm`, or `hot`.\n\nRules:\n\n* `cold`: general interest, testing, browsing, or no clear intent to buy.\n  Examples: \"just looking\", \"hello\", \"test\", \"interested in your services\".\n\n* `warm`: interested in the service or requesting information, but without urgency or project details.\n  Examples: \"need a consultation\", \"please call me back\", \"tell me more\".\n  Empty comments are also `warm`.\n\n* `hot`: strong buying intent, urgent requests, specific projects, timelines, budgets, or direct requests to contact immediately.\n  Examples: \"call me\", \"contact me\", \"urgent\", \"immediately\", \"as soon as possible\", \"need it this week\".\n\nTreat spelling mistakes and typos as valid input.\n\nReturn only valid JSON without explanations or markdown.\n\nOutput format:\n{\"status\":\"cold\"}\n"
            }
          ]
        },
        "batching": {}
      },
